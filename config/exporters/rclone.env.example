# Install as /etc/backmaster/exporters/rclone/nsys-postgres.env.
# Changing storage backends is an exporter configuration change, not a driver change.
RCLONE_DESTINATION=azure:backups/nsys-postgresql
# Use non-negative day counts, or unlimited (alias: none) to disable each cleanup.
RETENTION_DAYS=14
MINIMUM_REDUNDANCY=2
HEALTHCHECK_MAX_AGE_SECONDS=129600
WAL_RETENTION_DAYS=15
