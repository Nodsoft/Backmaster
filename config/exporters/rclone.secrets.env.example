# Install as /etc/backmaster/secrets/nsys-postgres-exporter.env with mode 0640.
# These environment names configure an rclone remote named "azure".
RCLONE_CONFIG_AZURE_TYPE=azureblob
RCLONE_CONFIG_AZURE_ACCOUNT=REPLACE_ME
RCLONE_CONFIG_AZURE_KEY=REPLACE_ME

# Prefer a managed identity where available:
# RCLONE_CONFIG_AZURE_USE_MSI=true
