# Install as /etc/backmaster/exporters/azcopy/nsys-postgres.env.
# The destination must include the Azure Blob container and may include a prefix.
AZCOPY_DESTINATION=https://REPLACE_ME.blob.core.windows.net/backups/nsys-postgresql

# AzCopy logs and job plans default to the instance state directory:
# /var/lib/backmaster/INSTANCE/azcopy/{logs,plans}. Override only with absolute,
# writable paths outside the staged backup payload.
# AZCOPY_LOG_LOCATION=/var/lib/backmaster/INSTANCE/azcopy/logs
# AZCOPY_JOB_PLAN_LOCATION=/var/lib/backmaster/INSTANCE/azcopy/plans
# Use non-negative day counts, or unlimited (alias: none) to disable each cleanup.
RETENTION_DAYS=14
MINIMUM_REDUNDANCY=2
HEALTHCHECK_MAX_AGE_SECONDS=129600
WAL_RETENTION_DAYS=15
