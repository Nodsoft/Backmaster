# Install as /etc/backmaster/secrets/nsys-postgres-azcopy.env with mode 0640.
# Prefer managed identity on Azure hosts:
AZCOPY_AUTO_LOGIN_TYPE=MSI

# For an on-premises service principal, replace MSI above with SPN and set:
# AZCOPY_SPA_APPLICATION_ID=REPLACE_ME
# AZCOPY_SPA_CLIENT_SECRET=REPLACE_ME
# AZCOPY_TENANT_ID=REPLACE_ME

# Alternatively use a scoped SAS token (with or without its leading question mark):
# AZCOPY_SAS_TOKEN=sv=REPLACE_ME&ss=b&...
