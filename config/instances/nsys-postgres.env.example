# Install independently on every capable runner as:
# /etc/backmaster/instances.d/nsys-postgres.env
INSTANCE_NAME=nsys-postgres
DRIVER=postgres
NODE_NAME=axon
DRIVER_CONFIG=/etc/backmaster/drivers/postgres/nsys-postgres.env
DRIVER_SECRET_FILE=/etc/backmaster/secrets/nsys-postgres.env

# 23 hours makes yesterday's backup stale at today's fallback window.
MAX_AGE_SECONDS=82800
CONSUL_LOCK_KEY=service/backmaster/nsys-postgres
CONSUL_LOCK_TIMEOUT=30s

# daily:        2026-08-02-axon
# daily-serial: 2026-08-02-001-axon
# daily-time:   2026-08-02T151423Z-axon
BACKUP_NAME_MODE=daily-time

# none, hostname, or custom. Custom suffixes require BACKUP_NAME_SUFFIX_VALUE.
BACKUP_NAME_SUFFIX_MODE=hostname
# BACKUP_NAME_SUFFIX_VALUE=axon
