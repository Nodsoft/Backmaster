# Install as /etc/backmaster/secrets/nsys-postgres.env with mode 0640 and
# ownership root:postgres. Never commit the populated file.
AZURE_STORAGE_CONNECTION_STRING=REPLACE_ME

# Alternatives supported by Barman:
# AZURE_STORAGE_ACCOUNT=REPLACE_ME
# AZURE_STORAGE_SAS_TOKEN=REPLACE_ME
# AZURE_CREDENTIAL_MODE=managed-identity

