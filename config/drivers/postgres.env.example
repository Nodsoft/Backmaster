# No storage-provider settings belong in this file.
PGHOST=/var/run/postgresql
PGPORT=5431
PGUSER=postgres

# Optional PostgreSQL/libpq connection variables such as PGPASSFILE, PGSSLMODE,
# PGSSLROOTCERT, and PGCONNECT_TIMEOUT are passed through. Put credential values
# or paths in DRIVER_SECRET_FILE; see docs/drivers/postgresql.md.

# physical creates a cluster-level pg_basebackup and supports WAL/PITR.
# logical creates globals.sql.gz plus one dump per selected DB.
PG_BACKUP_MODE=physical

# Maintenance database used for logical discovery and pg_dumpall.
PGDATABASE=postgres

# Physical-mode settings.
PG_COMPRESSION=client-gzip:level=6
PG_CHECKPOINT=fast

# Logical-mode output. Defaults preserve the original hashed custom archives.
# Set both values to plain for legible databases/NAME.sql files.
PG_LOGICAL_FORMAT=custom
PG_LOGICAL_FILE_NAMING=sha256

# Compression applies to custom archives only. Include/exclude values are
# newline-delimited exact database names. Empty include means every connectable,
# non-template database; exclusions take precedence. Leave both empty to dump
# all databases.
PG_LOGICAL_COMPRESSION=6
PG_LOGICAL_GLOBALS_GZIP_LEVEL=6
# PG_DATABASE_INCLUDE=$'postgres\napp\nmatrix'
# PG_DATABASE_EXCLUDE=$'scratch\ntest'
