# No storage-provider settings belong in this file.
PGHOST=/var/run/postgresql
PGPORT=5431
PGUSER=postgres

# physical creates a cluster-level pg_basebackup and supports WAL/PITR.
# logical creates globals.sql.gz plus one custom-format dump per selected DB.
PG_BACKUP_MODE=physical

# Maintenance database used for logical discovery and pg_dumpall.
PGDATABASE=postgres

# Physical-mode settings.
PG_COMPRESSION=client-gzip:level=6
PG_CHECKPOINT=fast

# Logical-mode settings. Include/exclude values are newline-delimited exact
# database names. Empty include means every connectable, non-template database;
# exclusions take precedence. Leave both empty to dump all databases.
PG_LOGICAL_COMPRESSION=6
PG_LOGICAL_GLOBALS_GZIP_LEVEL=6
# PG_DATABASE_INCLUDE=$'postgres\napp\nmatrix'
# PG_DATABASE_EXCLUDE=$'scratch\ntest'
