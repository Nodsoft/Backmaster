[Unit]
Description=Backmaster health check for %i
After=network-online.target

[Service]
Type=oneshot
User=backmaster
Group=backmaster
Environment=BACKMASTER_CONFIG_ROOT=/etc/backmaster
Environment=BACKMASTER_INSTALL_ROOT=/usr/lib/backmaster
ExecStart=/usr/bin/backmaster health %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=backmaster/%i
StateDirectoryMode=0750
ReadOnlyPaths=/etc/backmaster /usr/lib/backmaster
ReadWritePaths=/var/lib/backmaster/%i
